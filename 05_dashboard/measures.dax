Revenue = SUM(Sales[Revenue])
Orders = DISTINCTCOUNT(Sales[OrderID])
Customers = DISTINCTCOUNT(Sales[CustomerID])
Units Sold = SUM(Sales[Quantity])
Average Order Value = DIVIDE([Revenue], [Orders])
Profit = SUM(Sales[Profit])
Profit Margin = DIVIDE([Profit], [Revenue])
Revenue Previous Month = CALCULATE([Revenue], DATEADD('Date'[Date], -1, MONTH))
Revenue MoM % = DIVIDE([Revenue] - [Revenue Previous Month], [Revenue Previous Month])
